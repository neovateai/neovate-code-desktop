{
  "name": "neovate-code-extension",
  "displayName": "Neovate Code",
  "description": "Neovate Code VS Code Extension",
  "version": "0.1.1",
  "publisher": "afx",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "neovate.addToChat",
        "title": "Add to Chat"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "neovate.addToChat",
          "group": "navigation@0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "vsce package --no-dependencies",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack-cli": "^6.0.1",
    "webpack": "^5.105.0"
  },
  "repository": "https://github.com/neovateai/neovate-code-desktop.git",
  "dependencies": {
    "minimatch": "^10.1.2"
  }
}
